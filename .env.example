# ── Meta / WhatsApp ──────────────────────────────────────────
# Get these from developers.facebook.com → Your App → WhatsApp → API Setup
META_PHONE_NUMBER_ID=your_phone_number_id_here
# Temporary token expires (~24h). For production generate a permanent token via
# Meta Business Suite → Business settings → Users → System users → Add → Assign WhatsApp asset → whatsapp_business_messaging permission.
META_ACCESS_TOKEN=your_access_token_here

# Startup: Meta Graph self-check runs by default (no message sent). Set false to skip.
# META_STARTUP_CHECK=false

# Optional: protect GET /ready on public hosts (?secret=YOUR_VALUE matches this)
# READINESS_SECRET=

META_APP_SECRET=your_app_secret_here
# Any random string you choose — must match what you enter in Meta's webhook config.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_VERIFY_TOKEN=generate_a_long_random_string_here

# ── Google Sheets ─────────────────────────────────────────────
# Create a Service Account in Google Cloud Console, share the sheet with its email
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# repair_tickets: column H stores =IMAGE("https://…") for inline previews (readable URL for bots via extractHttpsUrlFromCell).
# SHEETS_USE_IMAGE_FORMULA=false writes plain URLs only (no thumbnail in cell).
# SHEETS_TICKETS_MAX_ROWS=2500
#
# repair_tickets column G — dropdown for status (`npm run sheet:status-dropdown` or run populate_sheet.js).
# Applies from row 2 through this spreadsheet row number (inclusive): default 5020.
# SHEETS_STATUS_VALIDATION_LAST_ROW=5020

# Status polling: pushes WhatsApp when column G wording changes vs data/repair_status_snapshot.json after each run.
# Optional: cron string (every 15 min default in code — change here for faster pushes e.g. */5 * * * *)
# STATUS_POLL_CRON=*/15 * * * *
# REPAIR_STATUS_CACHE_PATH=./data/repair_status_snapshot.json

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Terms & Conditions ───────────────────────────────────────────────────
# TERMS_URL      → text link (any clickable URL, incl. Google Drive share).
# TERMS_DOC_URL  → doc attach URL (must be direct-fetchable — Cloudinary/GitHub).
# Set either, both, or neither.
# TERMS_URL=https://drive.google.com/file/d/YOUR_DRIVE_FILE_ID/view
# TERMS_DOC_URL=

# ── Owners (WhatsApp digits only, country code without +) ──────────────────
# Two-tier owner routing — see src/utils/ownerPhones.js:
#
#   OWNER_PHONE_<NAME>       → GENERAL owner. Receives every alert
#                              (all repair tickets + all corporate leads).
#   BRANCH_OWNER_<SLUG>      → BRANCH-ONLY owner. Receives ONLY repair
#                              tickets for that store slug (ALKAPURI/SURSAGAR).
#                              Supports comma-separated list.
#
# General owners (all alerts):
OWNER_PHONE_VEDANT=91XXXXXXXXXX
OWNER_PHONE_VATSAL=91XXXXXXXXXX

# Branch-only owners (only their branch's repair tickets):
# BRANCH_OWNER_ALKAPURI=91XXXXXXXXXX
# BRANCH_OWNER_SURSAGAR=91XXXXXXXXXX

# ── App ───────────────────────────────────────────────────────
PORT=3000
# Set to `production` when deployed. Production enforces: webhook HMAC always on,
# startup fails fast if any Meta credential is missing, READINESS_SECRET required for /ready.
NODE_ENV=development

# Reverse-proxy hops in front of the bot (Railway/Render/ngrok = 1).
# Controls how the real client IP is derived for rate limiting.
# Defaults: 1 in production, 0 in development.
# TRUST_PROXY=1

# Row cap for generic tab reads (contacts / leads / broadcast queue). Default 10000.
# SHEETS_GENERIC_MAX_ROWS=10000

# ── Human handoff ("talk to a person") ─────────────────────────
# Cooldown on the OWNER alert only, in minutes. The customer always gets the
# contact details; this just stops three phones buzzing repeatedly if someone
# types the trigger several times. 0 disables. Default 30.
# HANDOFF_ALERT_COOLDOWN_MINUTES=30

# ── Post-service feedback ──────────────────────────────────────
# Approved Utility templates WITH 3 quick-reply buttons (see
# LAUNCH_CHECKLIST.md for the exact bodies to submit). Body vars:
#   {{1}} customer name · {{2}} ticket id
# FEEDBACK_TEMPLATE_EN=repair_feedback_en
# FEEDBACK_TEMPLATE_HI=repair_feedback_hi
# FEEDBACK_TEMPLATE_GU=repair_feedback_gu
#
# How long after the bag is seen as collected before asking. Default 24h —
# long enough that they've actually used the bag, short enough to still be
# fresh. Set 0 to ask on the next run after pickup.
# FEEDBACK_DELAY_HOURS=24
#
# Cron for the feedback check (the job enforces the delay + quiet hours).
# FEEDBACK_CRON=15 * * * *
#
# Ratings AT OR BELOW this trigger an immediate owner alert. Default 2.
# LOW_RATING_THRESHOLD=2

# ── Abuse / duplicate protection ───────────────────────────────
# Minimum gap between repair tickets from the SAME phone number, in minutes.
# Stops a scripted sender looping the repair flow (each ticket costs a Sheets
# write plus 2-3 billable owner-alert messages). Checked at the final step, so
# browsing the flow is never blocked. Set 0 to disable. Default 10.
# TICKET_MIN_INTERVAL_MINUTES=10
#
# How long a processed WhatsApp message id is remembered, in minutes, so a
# restart can't cause the same message to be handled twice (which would create
# a duplicate repair ticket). Meta retries undelivered webhooks with
# exponential backoff for up to SEVEN DAYS, so the default spans that whole
# window. Default 10080 (7 days).
# DEDUP_TTL_MINUTES=10080
#
# Hard ceiling on remembered message ids, as a backstop against unbounded
# growth. Eviction is oldest-first and is logged, since evicting early
# shortens the real dedup window. Default 20000 (~7 days of traffic).
# DEDUP_MAX_ENTRIES=20000
#
# Where the dedup file lives. Keep it on the same persistent volume as the
# other data/ files in production, or a redeploy resets the window.
# DEDUP_CACHE_PATH=./data/processed_messages.json

# ── Outbound safety (cost + Meta spam-ban protection) ──────────
# Circuit breaker on outbound WhatsApp messages. Defaults are generous — normal
# traffic never trips them; a runaway loop or a bad sheet row is stopped cold.
# OUTBOUND_MAX_PER_MIN=240
# OUTBOUND_MAX_PER_DAY=20000
# Panic stop: set to 1 to block ALL outbound sends immediately (then restart).
# OUTBOUND_KILL_SWITCH=0
# Hard ceiling on recipients per single broadcast (safety against mass-blast).
# BROADCAST_MAX_RECIPIENTS=5000

# ── Proactive customer messaging (COST CONTROL) ────────────────
# Business-initiated messages land outside WhatsApp's free 24h window, so they
# need PAID approved templates (~₹0.11 each). Defaults below are the free
# "pull-only" model: customers check status themselves via Track (free). Turn
# these on only after creating the templates and deciding the cost is worth it.
# Owner alerts (new ticket / lead) are NOT affected by these — they always send.
#
# ── Proactive repair-status updates (Feature 2) ────────────────
# Sends ALWAYS use an approved Utility template (no free/paid window logic —
# Meta bills in-window replies from 1 Oct 2026). Create these three templates
# in Meta Business Manager first; each takes 4 body variables:
#   {{1}} customer name · {{2}} ticket id · {{3}} current status · {{4}} store
# REPAIR_UPDATE_TEMPLATE_EN=repair_status_update_en
# REPAIR_UPDATE_TEMPLATE_HI=repair_status_update_hi
# REPAIR_UPDATE_TEMPLATE_GU=repair_status_update_gu
#
# Quiet hours — only message customers inside this IST window (24h clock).
# PROACTIVE_START_HOUR=10
# PROACTIVE_END_HOUR=19
#
# Days with no status change before sending a "still in progress" nudge.
# REPAIR_UPDATE_NUDGE_DAYS=3
#
# Log full phone numbers on proactive sends (default: last-4 only). The wamid
# is always logged and is what Meta's billing reports are keyed on.
# PROACTIVE_LOG_FULL_PHONE=false

# DEPRECATED (no longer read): STATUS_PUSH_MODE / PICKUP_TEMPLATE_NAME /
# REASSURANCE_* — the smart free-vs-paid branch and the reassurance job were
# retired in favour of always-template sends + the nudge above.
# Status-change pushes to customers: smart | off | ready_only | all
#   smart      = DEFAULT. Push any status change while the customer's 24h
#                service window is open (FREE — they messaged us <24h ago).
#                Window closed → only "Ready for Pickup" is sent: via
#                PICKUP_TEMPLATE_NAME if set (paid utility template,
#                ~₹0.115+GST), otherwise attempted free-form.
#   off        = never push (pure pull model)
#   ready_only = only "Ready for Pickup" pushes
#   all        = push every change regardless of window (needs templates)
# STATUS_PUSH_MODE=smart
#
# Approved UTILITY template for "Ready for Pickup" when the window is closed.
# Create in Meta → WhatsApp Manager → Message Templates with exactly TWO body
# variables: {{1}} = ticket id, {{2}} = store. Approve it in en / hi / gu.
# Leave unset until then — closed-window pickup pushes are dropped with a
# clear log instead of failing silently.
# PICKUP_TEMPLATE_NAME=
#
# Where the last-inbound-contact map lives (drives the free-window check).
# Persist it with a volume in production, like the status snapshot.
# LAST_CONTACT_CACHE_PATH=./data/last_contact.json
#
# 7-day "please collect your bag" reminder (off by default):
# PICKUP_REMINDER_ENABLED=false
#
# Daily "still working on it" reassurance ping (off by default; low value):
# REASSURANCE_ENABLED=false

# If Meta webhooks are ignored with "Invalid signature" but APP_SECRET is correct, your host may be
# rewriting the POST body. Set to 1 only while debugging, then remove.
# SKIP_WEBHOOK_SIGNATURE=1

# Daily reassurance if repair ticket sheet row not updated (optional; cron syntax, server TZ usually UTC on cloud)
# REASSURANCE_CRON=30 4 * * *
# REASSURANCE_STALE_HOURS=24
# REASSURANCE_MIN_HOURS=20
